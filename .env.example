# 实盘自动化容器环境变量（复制为 .env 后填写真实凭据，切勿提交 .env）
TZ=Asia/Shanghai

# 实盘调度参数
LIVE_CONFIG=configs/capital_100k/es_252d_fhs_stepdown_trend_200k_v2_563020_511130.yaml
LIVE_PORTFOLIO=live_es_252d_fhs_stepdown_trend_100k_v2_563020
LIVE_RUN_TIME=18:15
LIVE_SYNC=true
LIVE_NOTIFY=true
LIVE_MAX_RETRIES=2
LIVE_RETRY_DELAY_SECONDS=120
